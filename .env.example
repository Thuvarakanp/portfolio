# --- Database ---
DATABASE_URL="file:./prisma/dev.db"

# --- NextAuth (Auth.js v5) ---
# Generate with: npx auth secret  (or `node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"`)
AUTH_SECRET="replace-me-with-a-real-secret"
AUTH_TRUST_HOST="true"

# --- Admin credentials ---
# Username + password for /admin/login. Pick a strong password.
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="change-me-to-a-strong-password"

# --- Site ---
SITE_URL="http://localhost:3000"
